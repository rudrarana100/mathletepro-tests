# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here

# Optional: Supabase Service Role Key (for administrative tasks or RPC overrides)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
